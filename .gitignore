# Word Lens verified source cache (never bundled)
.word-lens-cache/

# Artefatos de release Android (AAB + mapping.txt) — arquivados localmente, nunca no Git
release-artifacts/

# Release notes derivadas pro Gradle Play Publisher — geradas pelo skill play-publish
# a partir de release-artifacts/*/release-notes.txt (a fonte da verdade fica lá)
android/app/src/main/play/

# Scripts/screenshots de debug em device e verificação Chromium via Playwright MCP — descartáveis
.tmp-e2e/
.playwright-mcp/
