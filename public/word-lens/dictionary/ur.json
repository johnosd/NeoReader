{"urban":{"partsOfSpeech":["adjective"],"senses":[{"definition":"located in or characteristic of a city or city life","examples":["urban property owners","urban affairs","urban manners"],"partOfSpeech":"adjective","synonyms":[]},{"definition":"relating to or concerned with a city or densely populated area","examples":["urban sociology","urban development"],"partOfSpeech":"adjective","synonyms":[]}]},"urge":{"partsOfSpeech":["noun","verb"],"senses":[{"definition":"a strong restless desire","examples":["why this urge to travel?"],"partOfSpeech":"noun","synonyms":["itch"]},{"definition":"an instinctive motive","examples":["profound religious impulses"],"partOfSpeech":"noun","synonyms":["impulse"]},{"definition":"force or impel in an indicated direction","examples":["I urged him to finish his studies"],"partOfSpeech":"verb","synonyms":["exhort","press","urge on"]},{"definition":"push for something","examples":["The travel agent recommended strongly that we not travel on Thanksgiving Day"],"partOfSpeech":"verb","synonyms":["advocate","recommend"]},{"definition":"spur on or encourage especially by cheers and shouts","examples":["The crowd cheered the demonstrating strikers"],"partOfSpeech":"verb","synonyms":["barrack","cheer","exhort","inspire","pep up","root on","urge on"]}]},"urgent":{"partsOfSpeech":["adjective"],"senses":[{"definition":"compelling immediate action","examples":["too pressing to permit of longer delay","the urgent words ‘Hurry! Hurry!’","bridges in urgent need of repair"],"partOfSpeech":"adjective","synonyms":["pressing"]}]},"urgently":{"partsOfSpeech":["adverb"],"senses":[{"definition":"with great urgency","examples":["health care reform is needed urgently","the soil desperately needed potash"],"partOfSpeech":"adverb","synonyms":["desperately"]}]}}
